# Port to expose on the host
PORT=5000

# Secret key for Flask sessions
SECRET_KEY=change-this-to-a-secure-random-secret

# Redis connection URL (default connects to bundled docker-compose redis service)
REDIS_URL=redis://redis:6379/0

# Build context: defaults to GitHub repo URL, change to '.' if building from local cloned files
# BUILD_CONTEXT=.

